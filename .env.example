# Environment variables for UserService Docker deployment
# Copy this file to .env and adjust values as needed

# Database Configuration
POSTGRES_DB=usersdb
POSTGRES_USER=app
POSTGRES_PASSWORD=secret

# R2DBC Configuration
ADAPTERS_R2DBC_HOST=postgres-users
ADAPTERS_R2DBC_PORT=5432
ADAPTERS_R2DBC_DATABASE=usersdb
ADAPTERS_R2DBC_USERNAME=app
ADAPTERS_R2DBC_PASSWORD=secret

# JWT Configuration
JWT_SECRET=mySecretKey123456789012345678901234567890
JWT_EXPIRATION=3600

# External Services
APPLICATION_SERVICE_BASE_URL=http://host.docker.internal:8098
APPLICATION_SERVICE_API_ENDPOINT=/api/v1/application

# Logging
LOG_LEVEL=INFO

# Docker Configuration
DOCKER_NETWORK=pragma-network
USER_SERVICE_PORT=8072
POSTGRES_PORT=5432

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3

# Performance Tuning
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseContainerSupport -XX:MaxRAMPercentage=70